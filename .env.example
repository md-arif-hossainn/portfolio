# --- Contact form (Resend) ---------------------------------------------------
# Create a free key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form messages are delivered. Defaults to arif.dev24@gmail.com.
CONTACT_TO_EMAIL=arif.dev24@gmail.com

# The "from" address. Resend's shared sandbox sender works out of the box and
# can only deliver to the email you signed up with. Once you verify your own
# domain in Resend, change this to something like "Portfolio <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
